#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Prepare CDP profile dirs and force desktop menu entries onto our launcher.
# Host bind-mounts created by Docker are root-owned; existing volumes may still
# have menu.xml / menu.xml.bak pointing at bare wrapped-chrome.

set -euo pipefail

ENABLE_CDP="${ENABLE_CDP:-false}"
CDP_PROFILE_DIR="${CDP_PROFILE_DIR:-/config/cdp-profile}"
CDP_LOG_DIR="${CDP_LOG_DIR:-/config/log}"

is_true() {
  case "${1,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

# Always make sure /config itself is owned by abc (idempotent; matches lsiown intent).
if [[ -d /config ]]; then
  lsiown abc:abc /config || chown abc:abc /config || true
fi

# Point labwc right-click "Chrome" at our launcher on every boot.
# Upstream init restores menu.xml from menu.xml.bak, so patch both.
patch_menu_file() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  if grep -q 'wrapped-chrome' "$f" 2>/dev/null; then
    sed -i \
      -e 's|/usr/bin/wrapped-chrome --enable-features=UseOzonePlatform --ozone-platform=wayland|/usr/local/bin/start-cdp-chrome.sh --enable-features=UseOzonePlatform --ozone-platform=wayland|g' \
      -e 's|/usr/bin/wrapped-chrome|/usr/local/bin/start-cdp-chrome.sh|g' \
      "$f"
    chown abc:abc "$f" 2>/dev/null || true
    echo "[init-cdp-profile] patched menu launcher in $f"
  fi
}

if [[ -d /config/.config/labwc ]]; then
  patch_menu_file /config/.config/labwc/menu.xml
  patch_menu_file /config/.config/labwc/menu.xml.bak
fi

if ! is_true "$ENABLE_CDP"; then
  echo "[init-cdp-profile] ENABLE_CDP is false; profile dir prep skipped (menu patch still applied if needed)."
  exit 0
fi

echo "[init-cdp-profile] preparing CDP_PROFILE_DIR=${CDP_PROFILE_DIR} CDP_LOG_DIR=${CDP_LOG_DIR}"

mkdir -p "$CDP_PROFILE_DIR" "$CDP_LOG_DIR"

if command -v lsiown >/dev/null 2>&1; then
  lsiown abc:abc "$CDP_PROFILE_DIR" "$CDP_LOG_DIR" || chown -R abc:abc "$CDP_PROFILE_DIR" "$CDP_LOG_DIR"
else
  chown -R abc:abc "$CDP_PROFILE_DIR" "$CDP_LOG_DIR"
fi

if ! s6-setuidgid abc touch "${CDP_PROFILE_DIR}/.cdp-write-test" 2>/dev/null; then
  echo "[init-cdp-profile] ERROR: abc cannot write to ${CDP_PROFILE_DIR}"
  ls -ld "$CDP_PROFILE_DIR" /config || true
  exit 1
fi
rm -f "${CDP_PROFILE_DIR}/.cdp-write-test"

echo "[init-cdp-profile] CDP profile dirs ready for abc ($(id -u abc):$(id -g abc))"
