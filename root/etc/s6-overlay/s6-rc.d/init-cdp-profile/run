#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Prepare CDP profile dirs and keep persisted labwc launchers aligned with the
# current image. This also makes existing /config volumes survive launcher renames.

set -euo pipefail

ENABLE_CDP="${ENABLE_CDP:-false}"
CDP_PROFILE_DIR="${CDP_PROFILE_DIR:-/config/cdp-profile}"
CDP_LOG_DIR="${CDP_LOG_DIR:-/config/log}"

is_true() {
  case "${1,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

# Always make sure /config itself is owned by abc (idempotent; matches lsiown intent).
if [[ -d /config ]]; then
  lsiown abc:abc /config || chown abc:abc /config || true
fi

# Persisted desktop files can outlive the image that created them. Normalize any
# prior start-cdp-*.sh launcher onto the current launcher without depending on a
# specific historical project name. Also normalize upstream wrapped-chrome menu
# entries and the browser window identifier used by labwc decoration rules.
patch_desktop_file() {
  local f="$1"
  [[ -f "$f" ]] || return 0

  if grep -Eq 'start-cdp-[^[:space:]"<]+\.sh|/usr/bin/wrapped-chrome|identifier="wrapped-[^"]+"' "$f" 2>/dev/null; then
    sed -i \
      -E \
      -e 's|/usr/local/bin/start-cdp-[^[:space:]"<]+\.sh|/usr/local/bin/start-cdp-chrome.sh|g' \
      -e 's|/usr/bin/wrapped-chrome --enable-features=UseOzonePlatform --ozone-platform=wayland|/usr/local/bin/start-cdp-chrome.sh --enable-features=UseOzonePlatform --ozone-platform=wayland|g' \
      -e 's|/usr/bin/wrapped-chrome|/usr/local/bin/start-cdp-chrome.sh|g' \
      -e 's|identifier="wrapped-[^"]+"|identifier="google-chrome"|g' \
      "$f"
    if [[ "$f" == *menu.xml* ]] && grep -q 'start-cdp-chrome.sh' "$f" 2>/dev/null; then
      sed -i -E \
        -e '/start-cdp-chrome\.sh/ s|label="[^"]+"|label="Chrome"|g' \
        -e '/start-cdp-chrome\.sh/ s|icon="[^"]+"|icon="/usr/share/icons/hicolor/48x48/apps/google-chrome.png"|g' \
        "$f"
    fi
    chown abc:abc "$f" 2>/dev/null || true
    echo "[init-cdp-profile] normalized persisted desktop launcher in $f"
  fi
}

if [[ -d /config/.config/labwc ]]; then
  patch_desktop_file /config/.config/labwc/autostart
  patch_desktop_file /config/.config/labwc/autostart.bak
  patch_desktop_file /config/.config/labwc/menu.xml
  patch_desktop_file /config/.config/labwc/menu.xml.bak
  patch_desktop_file /config/.config/labwc/rc.xml
fi

if ! is_true "$ENABLE_CDP"; then
  echo "[init-cdp-profile] ENABLE_CDP is false; profile dir prep skipped (desktop migration still applied if needed)."
  exit 0
fi

echo "[init-cdp-profile] preparing CDP_PROFILE_DIR=${CDP_PROFILE_DIR} CDP_LOG_DIR=${CDP_LOG_DIR}"

mkdir -p "$CDP_PROFILE_DIR" "$CDP_LOG_DIR"

if command -v lsiown >/dev/null 2>&1; then
  lsiown abc:abc "$CDP_PROFILE_DIR" "$CDP_LOG_DIR" || chown -R abc:abc "$CDP_PROFILE_DIR" "$CDP_LOG_DIR"
else
  chown -R abc:abc "$CDP_PROFILE_DIR" "$CDP_LOG_DIR"
fi

if ! s6-setuidgid abc touch "${CDP_PROFILE_DIR}/.cdp-write-test" 2>/dev/null; then
  echo "[init-cdp-profile] ERROR: abc cannot write to ${CDP_PROFILE_DIR}"
  ls -ld "$CDP_PROFILE_DIR" /config || true
  exit 1
fi
rm -f "${CDP_PROFILE_DIR}/.cdp-write-test"

echo "[init-cdp-profile] CDP profile dirs ready for abc ($(id -u abc):$(id -g abc))"
